{
  "name": "dk-dsh-context-tree",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "description": "Rewind a conversation in place: drop a message and everything after it from the model context, and put its text back in the composer",
  "license": "UNLICENSED",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/plan.js",
    "src/files.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "AGENTS.md",
    "locale"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check src/plan.js && node --check src/files.js && node --test test/*.test.js",
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
